#include "quantum.h" // 필요한 시스템 헤더
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

// --- UF2 슬롯 메모리 주소 설정 (CONVEX UF2 생성기 기준) ---
#define SLOT1_ADDR (FLASH_ADDR_UPDATE_SLOT + (FLASH_SIZE_SLOT * 0) + FLASH_SIZE_TAG)
#define SLOT2_ADDR (FLASH_ADDR_UPDATE_SLOT + (FLASH_SIZE_SLOT * 1) + FLASH_SIZE_TAG)
#define SLOT3_ADDR (FLASH_ADDR_UPDATE_SLOT + (FLASH_SIZE_SLOT * 2) + FLASH_SIZE_TAG)
#define SLOT4_ADDR (FLASH_ADDR_UPDATE_SLOT + (FLASH_SIZE_SLOT * 3) + FLASH_SIZE_TAG)



static const uint32_t SLOT_ADDRS[] = {SLOT1_ADDR, SLOT2_ADDR, SLOT3_ADDR, SLOT4_ADDR};
static uint8_t gif_file_buf[128*1024];


// --- 디자인 설정 ---
#define COLOR_BG lv_color_hex(0x000000) // GIF 몰입감을 위해 블랙 배경

// --- 앱 상태 관리 ---
typedef struct
{
  uint8_t   current_slot;
  lv_obj_t *gif_obj;
  bool      is_playing;
} gif_state_t;

static gif_state_t state;

// --- 전역 UI 핸들 ---
static lv_obj_t *root = NULL;

// --- GIF 로드 함수 ---
static void load_gif_from_slot(uint8_t slot_idx)
{
  if (slot_idx >= 4) return;
  if (root == NULL) return;

  // 1. 기존 GIF 객체 삭제
  if (state.gif_obj)
  {
    lv_obj_delete(state.gif_obj);
    state.gif_obj = NULL;
  }

  // 2. UF2 헤더에서 파일 정보 읽기
  uint32_t base_addr = SLOT_ADDRS[slot_idx];

  // 헤더 확인 (Magic String 체크 - 생략 가능하지만 안전을 위해)
  // char *magic = (char *)base_addr;

  // 헤더 오프셋 16에서 파일 사이즈 읽기 (Little Endian)
  uint32_t *size_ptr = (uint32_t *)(base_addr + 16);
  uint32_t  gif_size = *size_ptr;

  // 실제 데이터 시작 (오프셋 32)
   uint8_t *gif_data = (const uint8_t *)(base_addr + 32);

  if (gif_size == 0 || gif_size == 0xFFFFFFFF)
  {
    // 데이터가 없는 슬롯일 경우 처리
    return;
  }

  memcpy(gif_file_buf, (void *)(base_addr + 32), gif_size);
  gif_data = gif_file_buf;

  if (gif_data[0] != 'G' || gif_data[1] != 'I' || gif_data[2] != 'F')
  {
    logPrintf("Invalid GIF Signature: %c%c%c\n", gif_data[0], gif_data[1], gif_data[2]);
    return;
  }
  else
  {
    logPrintf("GIF FILE OK\n");
  }

  static lv_image_dsc_t gif_dsc;
  gif_dsc.header.cf = LV_COLOR_FORMAT_RAW; // RAW 데이터(GIF)임을 명시
  gif_dsc.header.w = 0;                    // GIF 디코더가 내부에서 파싱하므로 0
  gif_dsc.header.h = 0;
  gif_dsc.data_size = gif_size;            // 웹 변환기 헤더에서 읽어온 사이즈
  gif_dsc.data = gif_data;                 // 실제 GIF 데이터 시작 포인터

  // 3. LVGL GIF 객체 생성 및 설정
  state.gif_obj = lv_gif_create(root);
  lv_gif_set_src(state.gif_obj, &gif_dsc);
  lv_obj_center(state.gif_obj);

  state.current_slot = slot_idx;
  state.is_playing   = true;
}

// --- UI 초기화 ---
static void uiInit(void)
{
  root = lv_obj_create(lv_screen_active());
  lv_obj_set_size(root, 284, 76); // 디스플레이 크기 고정
  lv_obj_set_style_bg_color(root, COLOR_BG, 0);
  lv_obj_set_style_pad_all(root, 0, 0);
  lv_obj_set_style_border_width(root, 0, 0);
  lv_obj_clear_flag(root, LV_OBJ_FLAG_SCROLLABLE);

  qspiSetXipMode(true);

  // 초기 실행 시 SLOT 1 로드
  load_gif_from_slot(0);
}

static void uiDeInit(void)
{
  qspiSetXipMode(false);

  if (root)
  {
    lv_obj_delete(root);
    root          = NULL;
    state.gif_obj = NULL;
  }
}

// --- 키 입력 처리 (슬롯 변경) ---
bool gifSetKeycode(uint16_t keycode)
{
  bool ret = true;

  switch (keycode)
  {
    case KC_KP_1:
      load_gif_from_slot(0);
      break;          // 키패드 1번 -> SLOT 1
    case KC_KP_2:
      load_gif_from_slot(1);
      break;          // 키패드 2번 -> SLOT 2
    case KC_KP_3:
      load_gif_from_slot(2);
      break;          // 키패드 3번 -> SLOT 3
    case KC_KP_4:
      load_gif_from_slot(3);
      break;          // 키패드 4번 -> SLOT 4

    case KC_KP_ENTER: // 재생/일시정지 토글 (GIF 지원 여부에 따라 다름)
      if (state.gif_obj)
      {
        // 필요 시 lv_gif_pause/resume 로직 추가 가능
      }
      break;

    default:
      ret = false;
      break;
  }
  return ret;
}

// --- 메인 루프 ---
void gifMain(app_args_t *p_args)
{
  while (!p_args->is_exit)
  {
    // LVGL 타이머 핸들러 호출
    lv_timer_handler();
    delay(5);
  }
  uiDeInit();
}

// --- 앱 정보 등록 ---
app_info_t *gifGetAppInfo(void)
{
  static app_info_t info = {
    .id       = APP_ID_GIF,
    .name     = "GIF PLAYER",
    .init     = uiInit,
    .run_func = gifMain,
  };
  return &info;
}