#if 1

LV_FONT_DECLARE(convex32);
LV_FONT_DECLARE(convex24);
LV_FONT_DECLARE(convex20);
LV_FONT_DECLARE(convex16);



// 색상과 여백, 텍스트 스타일 상수
#define COLOR_NEON_PINK  lv_color_hex(0xFF00B9)
#define BG_COLOR         lv_color_hex(0x151820)  // 어두운 그레이톤
#define LEFT_PAD_PX      8
#define TOP_PAD_PX       6
#define GAP_BETWEEN_PX   2   // 날짜와 시각 라인 간 간격

// 외부 폰트 가정(없으면 LV_FONT_DEFAULT 사용)
extern const lv_font_t convex32;   // 없는 경우 주석 처리하고 LV_FONT_DEFAULT로 대체

static lv_obj_t *g_root = NULL;
static lv_obj_t *g_date_label = NULL;
static lv_obj_t *g_time_label = NULL;
static lv_timer_t *g_clock_timer = NULL;

// 원하는 자간과 굵기 연출값(글로우를 흉내 낼 수 없으므로 자간/굵기/색상으로 느낌만)
#define LETTER_SPACE_DATE  1
#define LETTER_SPACE_TIME  2



static void fmt_time_12h(int hour24, int min, char *out, size_t out_sz)
{
  const char *ampm = (hour24 >= 12) ? "PM" : "AM";
  int         h12  = hour24 % 12;
  if (h12 == 0) h12 = 12;
  // 예: "PM 00:00" 스타일이었으나, 12시간제 표기를 유지
  // 10:05 -> "AM 10:05"
  snprintf(out, out_sz, "%s %02d:%02d", ampm, h12, min);
}

static void clock_update_cb(lv_timer_t *timer)
{
  LV_UNUSED(timer);

  rtc_info_t info;

  rtcGetInfo(&info);

  // 날짜: YYYY.MM.DD
  char date_buf[32];
  snprintf(date_buf, sizeof(date_buf), "%04d.%02d.%02d", info.date.year + 2000, info.date.month, info.date.day);
  lv_label_set_text(g_date_label, date_buf);

  // 시간: "AM 10:05" 또는 "PM 03:07"
  char time_buf[32];
  fmt_time_12h(info.time.hours, info.time.minutes, time_buf, sizeof(time_buf));
  lv_label_set_text(g_time_label, time_buf);
}

void uiInit(void)
{
    // 화면 루트
    g_root = lv_obj_create(lv_screen_active());
    lv_obj_set_size(g_root, LCD_WIDTH, LCD_HEIGHT);
    lv_obj_set_style_bg_color(g_root, BG_COLOR, 0);
    lv_obj_set_style_bg_opa(g_root, LV_OPA_COVER, 0);
    lv_obj_set_style_pad_all(g_root, 0, 0);
    lv_obj_clear_flag(g_root, LV_OBJ_FLAG_SCROLLABLE);

    // 세로 배치 컨테이너
    lv_obj_t *col = lv_obj_create(g_root);
    lv_obj_remove_style_all(col);
    lv_obj_set_size(col, LV_PCT(100), LV_PCT(100));
    lv_obj_set_flex_flow(col, LV_FLEX_FLOW_COLUMN);
    lv_obj_set_flex_align(col, LV_FLEX_ALIGN_START, LV_FLEX_ALIGN_START, LV_FLEX_ALIGN_START);
    lv_obj_set_style_pad_left(col, LEFT_PAD_PX, 0);
    lv_obj_set_style_pad_top(col, TOP_PAD_PX, 0);
    lv_obj_set_style_pad_row(col, GAP_BETWEEN_PX, 0);

    // 공통 라벨 스타일
    static lv_style_t style_date, style_time;
    static bool style_inited = false;
    if (!style_inited)
    {
      lv_style_init(&style_date);
      lv_style_set_text_color(&style_date, lv_color_hex(0xFF00B9));
      lv_style_set_text_font(&style_date, &convex24); // 날짜용 폰트
      lv_style_set_bg_opa(&style_date, LV_OPA_0);

      lv_style_init(&style_time);
      lv_style_set_text_color(&style_time, lv_color_hex(0xFF00B9));
      lv_style_set_text_font(&style_time, &convex32); // 시간용 폰트
      lv_style_set_bg_opa(&style_time, LV_OPA_0);
    }

    // 날짜 라벨
    g_date_label = lv_label_create(col);
    lv_obj_add_style(g_date_label, &style_date, 0);
    lv_label_set_text(g_date_label, "0000.00.00");
    lv_obj_set_style_text_letter_space(g_date_label, LETTER_SPACE_DATE, 0);
    lv_obj_set_style_text_align(g_date_label, LV_TEXT_ALIGN_LEFT, 0);

    // 시각 라벨
    g_time_label = lv_label_create(col);
    lv_obj_add_style(g_time_label, &style_time, 0);
    lv_label_set_text(g_time_label, "PM 00:00");
    lv_obj_set_style_text_letter_space(g_time_label, LETTER_SPACE_TIME, 0);
    lv_obj_set_style_text_align(g_time_label, LV_TEXT_ALIGN_LEFT, 0);

    // 첫 갱신 및 타이머
    clock_update_cb(NULL);
    // 초단위로 갱신. 배터리/전력 고려 시 1초 또는 5초로 조정
    g_clock_timer = lv_timer_create(clock_update_cb, 1000, NULL);
}

// 필요 시 제거 함수
void ui_clock_destroy(void)
{
    if (g_clock_timer) {
        lv_timer_del(g_clock_timer);
        g_clock_timer = NULL;
    }
    if (g_root) {
        lv_obj_delete(g_root);
        g_root = NULL;
    }
}
#else
typedef struct
{
  char name[32];
  
  lv_image_dsc_t *img;

  void (*init)(void);
  void (*run_func)(void);
} app_info_t;

static app_info_t *p_app_info[APP_MAX_CNT];

void uiEvent(lv_event_t * e)
{
  lv_event_code_t code = lv_event_get_code(e);

  logPrintf("key event  %d\n", code);
  logPrintf("id  %d\n", (int)lv_event_get_user_data(e));

  req_run_id = (int)lv_event_get_user_data(e);
  is_req_run = true; 
}

void uiInit(void)
{
	lv_theme_t * th = lv_theme_default_init(NULL,
		lv_palette_main(LV_PALETTE_PURPLE),
		lv_palette_main(LV_PALETTE_RED),
		true,
		LV_FONT_DEFAULT);
	lv_disp_set_theme(NULL, th);

  main_disp = lv_obj_create(lv_screen_active());
  lv_obj_set_size(main_disp, LCD_WIDTH, LCD_HEIGHT);
  lv_obj_set_scroll_snap_x(main_disp, LV_SCROLL_SNAP_CENTER);
  lv_obj_set_scroll_snap_y(main_disp, LV_SCROLL_SNAP_CENTER);
  lv_obj_set_flex_flow(main_disp, LV_FLEX_FLOW_ROW);
  lv_obj_align(main_disp, LV_ALIGN_CENTER, 0, 0);
  lv_obj_set_scrollbar_mode(main_disp, LV_SCROLLBAR_MODE_OFF);
  lv_obj_set_scroll_dir(main_disp, LV_DIR_HOR);

  lv_obj_set_style_text_font(main_disp, &neo, LV_PART_MAIN);

  lv_group_t * g = lv_group_create();

  for (int i = 0; i < app_cnt; i++)
  {
    lv_obj_t *btn = lv_button_create(main_disp);
    lv_obj_set_size(btn, 150, lv_pct(70));

    lv_obj_t *label = lv_label_create(btn);
    lv_label_set_text_fmt(label, p_app_info[i]->name);
    lv_obj_center(label);
    lv_group_add_obj(g, btn);

    lv_obj_add_event_cb(btn, uiEvent, LV_EVENT_CLICKED, (void *)i);
    // lv_obj_set_style_text_font(label, &neo, LV_PART_MAIN);    
  }
  lv_indev_set_group(indev_keypad, g);

  lv_obj_scroll_to_view(lv_obj_get_child(main_disp, 0), LV_ANIM_OFF);
  lv_group_focus_obj(lv_obj_get_child(main_disp, 0));
  lv_obj_update_snap(main_disp, LV_ANIM_ON);
}
#endif